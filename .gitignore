# Go 后端产物
backend/server
backend/server.exe
*.exe
*.exe~

# 运行时数据（SQLite、WAL/SHM、.jwt_secret、.mfa_key，以及该目录下的任何文件）。
# 只忽略 data/.jwt_secret 时，在仓库根执行 git stash -u 会把 qsl.db 等装进 stash
# 并从磁盘上移走，容器重启后就是空库。整个 data/ 都必须留在工作区外。
data/

# 上传的卡片图。实体文件不进仓库（仓库根 ./uploads 与 backend/uploads 都算）。
# 目录由进程或数据卷创建，不把占位文件提交进来。
uploads/

# 前端
frontend/node_modules/
frontend/dist/

# 密钥与环境
.env

# 内部文档（不含入开源仓库）
HANDOFF.md
SECURITY-REVIEW-login-ratelimit.md

# 系统杂项
*.log
.DS_Store
Thumbs.db

# 本地冒烟测试产物（scripts/smoke-auth.ps1 会写这里：临时库、日志、请求正文）
backend/.tmp/

# E2E 运行时文件
scripts/img_b64.txt
scripts/test_adif.adi

# 手机端布局审计截图
scripts/_shots/

# 本地验证用（镜像内由前端阶段构建）
backend/web/dist/
